pragma cashscript ^0.12.0;

// =============================================================================
// MeshStrategyWithSurplusCapture — Configurable Frontend / SDK Surplus Routing
// =============================================================================
//
// Ensures that when a solver fills an intent against this Strategy UTXO:
// 1. LP receives 100% of their lpFee compounded into Output 0 reserve.
// 2. Surplus = grossAmountOut - userQuotedMinOut.
// 3. Protocol Treasury receives 50% of the surplus (Output 2). Non-bypassable.
// 4. The Frontend / SDK receives the remaining 50% surplus pool and can choose:
//    - Mode A: Pass 100% of it to user (userSurplusShare = nonProtocolSurplus) -> Output 1
//    - Mode B: Retain 100% for Frontend revenue (userSurplusShare = 0) -> Output 3
//    - Mode C: Configurable Split between User and Frontend (0 < userSurplusShare < nonProtocolSurplus)
// 5. User is ALWAYS guaranteed >= userQuotedMinOut.
// 6. 0% Exit (dock) fee for LP.
// =============================================================================

contract MeshStrategyWithSurplusCapture(
    bytes20 ownerPkh,              // LP owner (authorized dock key)
    bytes20 protocolTreasuryPkh,   // Protocol Treasury public key hash
    bytes tokenCategoryIn,         // Token coming in from user (0x for BCH)
    bytes tokenCategoryOut,        // Token going out to user (0x for BCH)
    int priceNumerator,            // Price numerator
    int priceDenominator,          // Price denominator
    int lpFeeBps                   // LP fee basis points (e.g. 25 = 0.25%)
) {
    /**
     * fillWithSurplusCapture()
     * Solver executes atomic fill against user intent with customizable frontend surplus allocation.
     */
    function fillWithSurplusCapture(
        int amountIn,
        bytes20 userMakerPkh,
        bytes20 frontendPkh,
        int userQuotedMinOut,
        int userSurplusShare
    ) {
        // 1. Validate incoming payment token category
        if (tokenCategoryIn != 0x) {
            require(tx.inputs[0].tokenCategory == tokenCategoryIn);
        }

        // 2. Read reserve balance of this Strategy UTXO
        int currentReserve = 0;
        if (tokenCategoryOut == 0x) {
            currentReserve = tx.inputs[this.activeInputIndex].value;
        } else {
            currentReserve = tx.inputs[this.activeInputIndex].tokenAmount;
        }

        // 3. Compute gross amountOut generated by this Strategy (maker-favorable: floor division)
        int grossAmountOut = (amountIn * priceNumerator * (10000 - lpFeeBps)) 
                             / (priceDenominator * 10000);

        require(grossAmountOut > 0);
        require(grossAmountOut <= currentReserve);
        require(grossAmountOut >= userQuotedMinOut);

        // 4. Calculate Surplus & Distribution
        int totalSurplus = grossAmountOut - userQuotedMinOut;
        int protocolShare = totalSurplus / 2;
        int nonProtocolSurplus = totalSurplus - protocolShare;

        // Ensure userSurplusShare is bounded within nonProtocolSurplus
        require(userSurplusShare >= 0);
        require(userSurplusShare <= nonProtocolSurplus);

        int frontendShare = nonProtocolSurplus - userSurplusShare;
        int finalUserPayout = userQuotedMinOut + userSurplusShare;

        // =====================================================================
        // STRICT ON-CHAIN OUTPUT ENFORCEMENT
        // =====================================================================

        // Output 0: Recreated Mesh Strategy UTXO (Remaining reserve + LP fee)
        require(tx.outputs[0].lockingBytecode == tx.inputs[this.activeInputIndex].lockingBytecode);
        int remainingReserve = currentReserve - grossAmountOut;

        // Output 1: User / Maker MUST receive (QuotedMin + User Surplus Share)
        bytes25 userLock = new LockingBytecodeP2PKH(userMakerPkh);
        require(tx.outputs[1].lockingBytecode == userLock);

        // --- Output 0 & 1 Value Enforcement ---
        if (tokenCategoryOut == 0x) {
            // Native BCH Settlement
            require(tx.outputs[0].value == remainingReserve);
            require(tx.outputs[1].value >= finalUserPayout);
        } else {
            // CashTokens Settlement
            require(tx.outputs[0].tokenCategory == tokenCategoryOut);
            require(tx.outputs[0].tokenAmount == remainingReserve);
            require(tx.outputs[0].value >= 1000); // 1,000 sat dust guard

            require(tx.outputs[1].tokenCategory == tokenCategoryOut);
            require(tx.outputs[1].tokenAmount >= finalUserPayout);
            require(tx.outputs[1].value >= 1000);
        }

        // --- Output 2: Protocol Treasury (50% Surplus Share when surplus > 0) ---
        if (protocolShare > 0) {
            bytes25 treasuryLock = new LockingBytecodeP2PKH(protocolTreasuryPkh);
            require(tx.outputs[2].lockingBytecode == treasuryLock);

            if (tokenCategoryOut == 0x) {
                require(tx.outputs[2].value >= protocolShare);
            } else {
                require(tx.outputs[2].tokenCategory == tokenCategoryOut);
                require(tx.outputs[2].tokenAmount >= protocolShare);
                require(tx.outputs[2].value >= 1000);
            }
        }

        // --- Output 3: Frontend / Integrator Share (when frontendShare > 0) ---
        if (frontendShare > 0) {
            bytes25 frontendLock = new LockingBytecodeP2PKH(frontendPkh);
            require(tx.outputs[3].lockingBytecode == frontendLock);

            if (tokenCategoryOut == 0x) {
                require(tx.outputs[3].value >= frontendShare);
            } else {
                require(tx.outputs[3].tokenCategory == tokenCategoryOut);
                require(tx.outputs[3].tokenAmount >= frontendShare);
                require(tx.outputs[3].value >= 1000);
            }
        }
    }

    /**
     * dock() — Unconditional 0% Fee Exit for LP
     */
    function dock(pubkey ownerPk, sig ownerSig) {
        require(hash160(ownerPk) == ownerPkh);
        require(checkSig(ownerSig, ownerPk));
    }
}
