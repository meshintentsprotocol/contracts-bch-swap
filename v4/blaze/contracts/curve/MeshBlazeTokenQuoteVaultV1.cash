pragma cashscript ^0.14.0;

// Mesh Blaze CashToken-quote vault prototype. Input/output 0 is the unique
// launch-category mutable state NFT; input/output 1 is this paired quote vault.
// The base vault must independently enforce curve price and fee arithmetic.
// This buy-only prototype is not a complete public launch covenant.
contract MeshBlazeTokenQuoteVaultV1(
    bytes32 launchCat,
    bytes32 quoteCat,
    bytes8 quoteCarrier
) {
    function buy() {
        require(this.activeInputIndex == 1);
        require(tx.inputs.length == 3 && (tx.outputs.length == 3 || tx.outputs.length == 4));
        require(launchCat != quoteCat && int(quoteCarrier) >= 1000);
        require(tx.inputs[0].tokenCategory == launchCat + 0x01);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);

        bytes inState = tx.inputs[0].nftCommitment;
        bytes outState = tx.outputs[0].nftCommitment;
        require(inState.length == 34 && outState.length == 34);
        require(inState.split(2)[0] == 0x0100);
        require(outState.split(1)[0] == 0x01);
        int q0 = int(inState.split(2)[1].split(8)[0]);
        int c0 = int(inState.split(10)[1].split(8)[0]);
        int p0 = int(inState.split(18)[1].split(8)[0]);
        int r0 = int(inState.split(26)[1]);
        int q1 = int(outState.split(2)[1].split(8)[0]);
        int c1 = int(outState.split(10)[1].split(8)[0]);
        int p1 = int(outState.split(18)[1].split(8)[0]);
        int r1 = int(outState.split(26)[1]);
        require(min(min(q0, c0), min(p0, r0)) >= 0);
        require(min(min(q1, c1), min(p1, r1)) >= 0);
        int held0 = q0 + c0 + p0 + r0;
        int held1 = q1 + c1 + p1 + r1;
        require(held1 > held0);

        require(tx.inputs[1].value == int(quoteCarrier));
        require(tx.outputs[1].value == tx.inputs[1].value);
        require(tx.outputs[1].lockingBytecode == tx.inputs[1].lockingBytecode);
        if (held0 == 0) {
            require(tx.inputs[1].tokenAmount == 0);
        } else {
            require(tx.inputs[1].tokenCategory == quoteCat);
            require(tx.inputs[1].tokenAmount == held0);
        }
        require(tx.outputs[1].tokenCategory == quoteCat);
        require(tx.outputs[1].tokenAmount == held1);

        require(tx.inputs[2].tokenCategory == quoteCat);
        require(tx.inputs[2].tokenAmount >= held1 - held0);
        require(tx.outputs[2].tokenCategory == launchCat);
        require(tx.outputs[2].tokenAmount == tx.inputs[0].tokenAmount - tx.outputs[0].tokenAmount);
        require(tx.outputs[2].lockingBytecode == tx.inputs[2].lockingBytecode);
        require(tx.outputs[2].value >= 1000);
        if (tx.inputs[2].tokenAmount == held1 - held0) {
            require(tx.outputs.length == 3);
            require(tx.outputs[2].value >= tx.inputs[2].value - 5000);
        } else {
            require(tx.outputs.length == 4);
            require(tx.outputs[3].tokenCategory == quoteCat);
            require(tx.outputs[3].tokenAmount == tx.inputs[2].tokenAmount - (held1 - held0));
            require(tx.outputs[3].lockingBytecode == tx.inputs[2].lockingBytecode);
            require(tx.outputs[3].value >= 1000);
            require(tx.outputs[2].value + tx.outputs[3].value >= tx.inputs[2].value - 5000);
        }
    }

    function sell() {
        require(this.activeInputIndex == 1);
        require(tx.inputs.length == 3 && tx.outputs.length == 3);
        require(tx.inputs[0].tokenCategory == launchCat + 0x01);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        bytes inState = tx.inputs[0].nftCommitment;
        bytes outState = tx.outputs[0].nftCommitment;
        require(inState.length == 34 && outState.length == 34);
        require(inState.split(2)[0] == 0x0100 && outState.split(2)[0] == 0x0100);
        int q0 = int(inState.split(2)[1].split(8)[0]);
        int c0 = int(inState.split(10)[1].split(8)[0]);
        int p0 = int(inState.split(18)[1].split(8)[0]);
        int r0 = int(inState.split(26)[1]);
        int q1 = int(outState.split(2)[1].split(8)[0]);
        int c1 = int(outState.split(10)[1].split(8)[0]);
        int p1 = int(outState.split(18)[1].split(8)[0]);
        int r1 = int(outState.split(26)[1]);
        require(min(min(q0, c0), min(p0, r0)) >= 0);
        require(min(min(q1, c1), min(p1, r1)) >= 0);
        require(q0 > q1 && q1 >= 0);
        int held0 = q0 + c0 + p0 + r0;
        int held1 = q1 + c1 + p1 + r1;
        require(held0 > held1 && held1 >= 0);
        require(tx.inputs[1].value == int(quoteCarrier) && tx.outputs[1].value == tx.inputs[1].value);
        require(tx.outputs[1].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.inputs[1].tokenCategory == quoteCat && tx.inputs[1].tokenAmount == held0);
        require(tx.outputs[1].tokenAmount == held1);
        if (held1 > 0) require(tx.outputs[1].tokenCategory == quoteCat);
        require(tx.inputs[2].tokenCategory == launchCat);
        require(tx.inputs[2].tokenAmount == tx.outputs[0].tokenAmount - tx.inputs[0].tokenAmount);
        require(tx.outputs[2].tokenCategory == quoteCat);
        require(tx.outputs[2].tokenAmount == held0 - held1);
        require(tx.outputs[2].lockingBytecode == tx.inputs[2].lockingBytecode);
        require(tx.outputs[2].value >= 1000 && tx.outputs[2].value >= tx.inputs[2].value - 5000);
    }

    function claim(int role) {
        require(this.activeInputIndex == 1);
        require(tx.inputs.length == 3 && tx.outputs.length == 4);
        require(tx.inputs[0].tokenCategory == launchCat + 0x01);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenAmount == tx.inputs[0].tokenAmount);
        bytes inState = tx.inputs[0].nftCommitment;
        bytes outState = tx.outputs[0].nftCommitment;
        require(inState.length == 34 && outState.length == 34);
        require(inState.split(2)[0] == outState.split(2)[0]);
        require(inState.split(1)[0] == 0x01);
        int q0 = int(inState.split(2)[1].split(8)[0]);
        int c0 = int(inState.split(10)[1].split(8)[0]);
        int p0 = int(inState.split(18)[1].split(8)[0]);
        int r0 = int(inState.split(26)[1]);
        int q1 = int(outState.split(2)[1].split(8)[0]);
        int c1 = int(outState.split(10)[1].split(8)[0]);
        int p1 = int(outState.split(18)[1].split(8)[0]);
        int r1 = int(outState.split(26)[1]);
        require(min(min(q0, c0), min(p0, r0)) >= 0);
        require(min(min(q1, c1), min(p1, r1)) >= 0);
        require(q0 == q1);
        int amount = 0;
        if (role == 0) {
            amount = c0;
            require(c1 == 0 && p1 == p0 && r1 == r0);
        } else if (role == 1) {
            amount = p0;
            require(c1 == c0 && p1 == 0 && r1 == r0);
        } else {
            require(role == 2);
            amount = r0;
            require(c1 == c0 && p1 == p0 && r1 == 0);
        }
        require(amount > 0);
        int held0 = q0 + c0 + p0 + r0;
        int held1 = q1 + c1 + p1 + r1;
        require(tx.inputs[1].value == int(quoteCarrier) && tx.outputs[1].value == tx.inputs[1].value);
        require(tx.outputs[1].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.inputs[1].tokenCategory == quoteCat && tx.inputs[1].tokenAmount == held0);
        require(tx.outputs[1].tokenAmount == held1);
        if (held1 > 0) require(tx.outputs[1].tokenCategory == quoteCat);
        require(held0 - held1 == amount);
        require(tx.outputs[2].tokenCategory == quoteCat && tx.outputs[2].tokenAmount == amount);
        require(tx.outputs[2].value >= 1000);
        require(tx.outputs[3].lockingBytecode == tx.inputs[2].lockingBytecode);
        require(tx.outputs[3].value >= 546);
        require(tx.outputs[2].value + tx.outputs[3].value >= tx.inputs[2].value - 5000);
    }
}
