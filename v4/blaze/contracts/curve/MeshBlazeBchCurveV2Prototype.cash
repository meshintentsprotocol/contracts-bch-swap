pragma cashscript ^0.14.0;

// Mesh Blaze BCH-quote curve V2 GRADUATION PROTOTYPE. One UTXO holds launch FT plus a mutable
// NFT of the SAME category. Its 34-byte commitment stores real BCH reserve and
// accrued fee rights. The NFT is not minting authority.
//
// Stage 0 trades; stage 1 is complete. There is deliberately no owner exit.
// The graduation path below only proves asset allocation and destination
// hashes. Its archive and market destination artifacts are not release ready.
contract MeshBlazeBchCurveV2Prototype(
    bytes32 tokenCat,
    bytes8 virtualBase,
    bytes8 virtualQuote,
    bytes8 quoteThreshold,
    bytes8 carrier,
    bytes2 creatorFeeBps,
    bytes2 partnerFeeBps,
    bytes2 protocolFeeBps,
    bytes32 creatorRecipientHash,
    bytes32 partnerRecipientHash,
    bytes32 protocolRecipientHash,
    bytes32 lockedBinScriptHash,
    bytes32 creatorBinScriptHash,
    bytes32 stateArchiveScriptHash,
    bytes2 lockedBps,
    bytes32 creatorCollectorScriptHash,
    bytes32 partnerCollectorScriptHash,
    bytes32 protocolCollectorScriptHash,
    bytes8 collectorCarrier
) {
    function buy() {
        int i = this.activeInputIndex;
        require(i == 0 && tx.inputs.length == 2 && tx.outputs.length == 3);
        bytes inState = tx.inputs[i].nftCommitment;
        bytes outState = tx.outputs[i].nftCommitment;
        require(inState.length == 34 && outState.length == 34);
        require(inState.split(2)[0] == 0x0100);
        require(outState.split(1)[0] == 0x01);
        require(tx.inputs[i].tokenCategory == tokenCat + 0x01);
        require(tx.outputs[i].tokenCategory == tx.inputs[i].tokenCategory);
        require(tx.outputs[i].lockingBytecode == tx.inputs[i].lockingBytecode);
        require(int(virtualBase) > 0 && int(virtualQuote) > 0 && int(quoteThreshold) > 0);

        int q0 = int(inState.split(2)[1].split(8)[0]);
        int c0 = int(inState.split(10)[1].split(8)[0]);
        int p0 = int(inState.split(18)[1].split(8)[0]);
        int r0 = int(inState.split(26)[1]);
        int q1 = int(outState.split(2)[1].split(8)[0]);
        int c1 = int(outState.split(10)[1].split(8)[0]);
        int p1 = int(outState.split(18)[1].split(8)[0]);
        int r1 = int(outState.split(26)[1]);
        require(min(min(q0, c0), min(p0, r0)) >= 0);
        require(min(min(q1, c1), min(p1, r1)) >= 0);
        require(q0 < int(quoteThreshold) && q1 <= int(quoteThreshold));
        if (q1 == int(quoteThreshold)) {
            require(outState.split(1)[1].split(1)[0] == 0x01);
        } else {
            require(outState.split(1)[1].split(1)[0] == 0x00);
        }
        require(tx.inputs[i].value == int(carrier) + q0 + c0 + p0 + r0);
        require(tx.outputs[i].value == int(carrier) + q1 + c1 + p1 + r1);
        int b0 = tx.inputs[i].tokenAmount;
        int b1 = tx.outputs[i].tokenAmount;
        require(b0 > b1 && b1 >= 0);
        require(tx.outputs[1].tokenCategory == tokenCat);
        require(tx.outputs[1].tokenAmount == b0 - b1);
        require(tx.outputs[1].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.outputs[1].value >= 546);
        require(tx.outputs[2].lockingBytecode == tx.inputs[1].lockingBytecode);

        int gross = tx.outputs[i].value - tx.inputs[i].value;
        int feeBps = int(creatorFeeBps) + int(partnerFeeBps) + int(protocolFeeBps);
        require(gross > 0 && feeBps > 0 && feeBps < 10000);
        int fee = gross * feeBps / 10000;
        int creator = fee * int(creatorFeeBps) / feeBps;
        int partner = fee * int(partnerFeeBps) / feeBps;
        int protocol = fee - creator - partner;
        if (int(protocolFeeBps) == 0) {
            if (int(creatorFeeBps) > 0) {
                creator += protocol;
            } else {
                partner += protocol;
            }
            protocol = 0;
        }
        int net = gross - fee;
        require(c1 == c0 + creator && p1 == p0 + partner && r1 == r0 + protocol);
        require(q1 == q0 + net);
        if (q1 == int(quoteThreshold)) {
            int previousGross = gross - 1;
            require(q0 + previousGross - previousGross * feeBps / 10000 < int(quoteThreshold));
        }
        // The buyer's change output keeps every satoshi beyond the used gross,
        // token carrier and a bounded network fee under the buyer's script.
        require(tx.outputs[2].value >= tx.inputs[1].value - gross - tx.outputs[1].value - 5000);
        require(b0 - b1 == (b0 + int(virtualBase)) * net / (q0 + int(virtualQuote) + net));
    }

    function sell() {
        int i = this.activeInputIndex;
        require(i == 0 && tx.inputs.length == 2 && tx.outputs.length == 2);
        bytes inState = tx.inputs[i].nftCommitment;
        bytes outState = tx.outputs[i].nftCommitment;
        require(inState.length == 34 && outState.length == 34);
        require(inState.split(2)[0] == 0x0100 && outState.split(2)[0] == 0x0100);
        require(tx.inputs[i].tokenCategory == tokenCat + 0x01);
        require(tx.outputs[i].tokenCategory == tx.inputs[i].tokenCategory);
        require(tx.outputs[i].lockingBytecode == tx.inputs[i].lockingBytecode);
        require(int(virtualBase) > 0 && int(virtualQuote) > 0 && int(quoteThreshold) > 0);

        int q0 = int(inState.split(2)[1].split(8)[0]);
        int c0 = int(inState.split(10)[1].split(8)[0]);
        int p0 = int(inState.split(18)[1].split(8)[0]);
        int r0 = int(inState.split(26)[1]);
        int q1 = int(outState.split(2)[1].split(8)[0]);
        int c1 = int(outState.split(10)[1].split(8)[0]);
        int p1 = int(outState.split(18)[1].split(8)[0]);
        int r1 = int(outState.split(26)[1]);
        require(min(min(q0, c0), min(p0, r0)) >= 0);
        require(min(min(q1, c1), min(p1, r1)) >= 0);
        require(q0 < int(quoteThreshold));
        require(tx.inputs[i].value == int(carrier) + q0 + c0 + p0 + r0);
        require(tx.outputs[i].value == int(carrier) + q1 + c1 + p1 + r1);
        int b0 = tx.inputs[i].tokenAmount;
        int b1 = tx.outputs[i].tokenAmount;
        require(b1 > b0 && b0 >= 0);
        require(tx.inputs[1].tokenCategory == tokenCat);
        require(tx.inputs[1].tokenAmount == b1 - b0);
        require(tx.outputs[1].lockingBytecode == tx.inputs[1].lockingBytecode);

        int gross = q0 - q1;
        int feeBps = int(creatorFeeBps) + int(partnerFeeBps) + int(protocolFeeBps);
        require(gross > 0 && gross <= q0 && feeBps > 0 && feeBps < 10000);
        int fee = gross * feeBps / 10000;
        int creator = fee * int(creatorFeeBps) / feeBps;
        int partner = fee * int(partnerFeeBps) / feeBps;
        int protocol = fee - creator - partner;
        if (int(protocolFeeBps) == 0) {
            if (int(creatorFeeBps) > 0) {
                creator += protocol;
            } else {
                partner += protocol;
            }
            protocol = 0;
        }
        require(c1 == c0 + creator && p1 == p0 + partner && r1 == r0 + protocol);
        require(tx.inputs[i].value - tx.outputs[i].value == gross - fee);
        require(tx.outputs[1].value >= tx.inputs[1].value + gross - fee - 5000);
        require(gross == (q0 + int(virtualQuote)) * (b1 - b0) / (b0 + int(virtualBase) + (b1 - b0)));
    }

    // Anyone may submit a claim. The immutable constructor hashes bind the
    // payout scripts; the state NFT carries the balance consumed by this claim.
    function claim(int role) {
        int i = this.activeInputIndex;
        bytes inState = tx.inputs[i].nftCommitment;
        bytes outState = tx.outputs[i].nftCommitment;
        require(inState.length == 34 && outState.length == 34);
        require(inState.split(1)[0] == 0x01 && outState.split(2)[0] == inState.split(2)[0]);
        require(tx.inputs[i].tokenCategory == tokenCat + 0x01);
        require(tx.outputs[i].tokenCategory == tx.inputs[i].tokenCategory);
        require(tx.outputs[i].lockingBytecode == tx.inputs[i].lockingBytecode);
        require(tx.outputs[i].tokenAmount == tx.inputs[i].tokenAmount);

        int q0 = int(inState.split(2)[1].split(8)[0]);
        int c0 = int(inState.split(10)[1].split(8)[0]);
        int p0 = int(inState.split(18)[1].split(8)[0]);
        int r0 = int(inState.split(26)[1]);
        int q1 = int(outState.split(2)[1].split(8)[0]);
        int c1 = int(outState.split(10)[1].split(8)[0]);
        int p1 = int(outState.split(18)[1].split(8)[0]);
        int r1 = int(outState.split(26)[1]);
        require(min(min(q0, c0), min(p0, r0)) >= 0);
        require(min(min(q1, c1), min(p1, r1)) >= 0);
        require(q0 == q1 && q0 <= int(quoteThreshold));
        require(tx.inputs[i].value == int(carrier) + q0 + c0 + p0 + r0);
        require(tx.outputs[i].value == int(carrier) + q1 + c1 + p1 + r1);

        int claimAmount = 0;
        bytes32 recipientHash = creatorRecipientHash;
        if (role == 0) {
            claimAmount = c0;
            require(c1 == 0 && p1 == p0 && r1 == r0);
        } else if (role == 1) {
            claimAmount = p0;
            recipientHash = partnerRecipientHash;
            require(c1 == c0 && p1 == 0 && r1 == r0);
        } else {
            require(role == 2);
            claimAmount = r0;
            recipientHash = protocolRecipientHash;
            require(c1 == c0 && p1 == p0 && r1 == 0);
        }
        require(claimAmount >= 1000);
        require(tx.inputs[i].value - tx.outputs[i].value == claimAmount);
        require(tx.outputs[i + 1].value == claimAmount);
        require(sha256(tx.outputs[i + 1].lockingBytecode) == recipientHash);
    }

    // Completed curve -> locked bin + creator bin + NFT archive + three
    // fee collectors + sponsor change. Every market dependency is funded here.
    // Both asset shares are checked separately. Fee rights must be claimed first.
    function graduate() {
        require(this.activeInputIndex == 0 && tx.inputs.length == 2 && tx.outputs.length == 7);
        bytes state = tx.inputs[0].nftCommitment;
        require(state.length == 34 && state.split(2)[0] == 0x0101);
        require(tx.inputs[0].tokenCategory == tokenCat + 0x01);
        int quote = int(state.split(2)[1].split(8)[0]);
        int creatorFees = int(state.split(10)[1].split(8)[0]);
        int partnerFees = int(state.split(18)[1].split(8)[0]);
        int protocolFees = int(state.split(26)[1]);
        require(quote == int(quoteThreshold) && quote > 0);
        require(creatorFees == 0 && partnerFees == 0 && protocolFees == 0);
        require(tx.inputs[0].value == int(carrier) + quote);
        int base = tx.inputs[0].tokenAmount;
        require(base > 0);
        require(tx.inputs[1].tokenCategory == 0x && tx.inputs[1].nftCommitment == 0x);

        require(sha256(tx.outputs[0].lockingBytecode) == lockedBinScriptHash);
        require(sha256(tx.outputs[1].lockingBytecode) == creatorBinScriptHash);
        require(sha256(tx.outputs[2].lockingBytecode) == stateArchiveScriptHash);
        require(tx.outputs[6].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tokenCat && tx.outputs[1].tokenCategory == tokenCat);
        require(tx.outputs[0].nftCommitment == 0x && tx.outputs[1].nftCommitment == 0x);
        require(tx.outputs[2].tokenCategory == tokenCat + 0x01);
        require(tx.outputs[2].nftCommitment == state && tx.outputs[2].tokenAmount == 0);
        require(int(collectorCarrier) >= 1000);
        require(sha256(tx.outputs[3].lockingBytecode) == creatorCollectorScriptHash);
        require(sha256(tx.outputs[4].lockingBytecode) == partnerCollectorScriptHash);
        require(sha256(tx.outputs[5].lockingBytecode) == protocolCollectorScriptHash);
        require(tx.outputs[3].value == int(collectorCarrier));
        require(tx.outputs[4].value == int(collectorCarrier));
        require(tx.outputs[5].value == int(collectorCarrier));
        require(tx.outputs[3].tokenCategory == 0x && tx.outputs[4].tokenCategory == 0x);
        require(tx.outputs[5].tokenCategory == 0x && tx.outputs[6].tokenCategory == 0x);
        require(tx.outputs[2].value == int(carrier));

        int lockedBase = tx.outputs[0].tokenAmount;
        int creatorBase = tx.outputs[1].tokenAmount;
        int lockedQuote = tx.outputs[0].value - 1000;
        int creatorQuote = tx.outputs[1].value - 1000;
        int lock = int(lockedBps);
        require(lock >= 9000 && lock < 10000);
        require(lockedBase > 0 && creatorBase > 0 && lockedQuote > 0 && creatorQuote > 0);
        require(lockedBase + creatorBase == base && lockedQuote + creatorQuote == quote);
        int baseWhole = base / 10000;
        int baseRem = base - baseWhole * 10000;
        int quoteWhole = quote / 10000;
        int quoteRem = quote - quoteWhole * 10000;
        require(lockedBase >= baseWhole * lock + (baseRem * lock + 9999) / 10000);
        require(lockedQuote >= quoteWhole * lock + (quoteRem * lock + 9999) / 10000);
        require(tx.outputs[6].value >= 546);
        require(tx.outputs[6].value >= tx.inputs[1].value - 2000 - 3 * int(collectorCarrier) - 5000);
    }

    // Full permanent lock has no creator bin output; all collectors are still funded.
    function graduateAll() {
        require(this.activeInputIndex == 0 && tx.inputs.length == 2 && tx.outputs.length == 6);
        require(int(lockedBps) == 10000);
        bytes state = tx.inputs[0].nftCommitment;
        require(state.length == 34 && state.split(2)[0] == 0x0101);
        require(tx.inputs[0].tokenCategory == tokenCat + 0x01);
        int quote = int(state.split(2)[1].split(8)[0]);
        require(quote == int(quoteThreshold) && quote > 0);
        require(int(state.split(10)[1].split(8)[0]) == 0);
        require(int(state.split(18)[1].split(8)[0]) == 0);
        require(int(state.split(26)[1]) == 0);
        require(tx.inputs[0].value == int(carrier) + quote);
        require(tx.inputs[0].tokenAmount > 0);
        require(tx.inputs[1].tokenCategory == 0x && tx.inputs[1].nftCommitment == 0x);
        require(sha256(tx.outputs[0].lockingBytecode) == lockedBinScriptHash);
        require(tx.outputs[0].tokenCategory == tokenCat && tx.outputs[0].nftCommitment == 0x);
        require(tx.outputs[0].tokenAmount == tx.inputs[0].tokenAmount);
        require(tx.outputs[0].value == quote + 1000);
        require(sha256(tx.outputs[1].lockingBytecode) == stateArchiveScriptHash);
        require(tx.outputs[1].tokenCategory == tokenCat + 0x01);
        require(tx.outputs[1].nftCommitment == state && tx.outputs[1].tokenAmount == 0);
        require(tx.outputs[1].value == int(carrier));
        require(int(collectorCarrier) >= 1000);
        require(sha256(tx.outputs[2].lockingBytecode) == creatorCollectorScriptHash);
        require(sha256(tx.outputs[3].lockingBytecode) == partnerCollectorScriptHash);
        require(sha256(tx.outputs[4].lockingBytecode) == protocolCollectorScriptHash);
        require(tx.outputs[2].value == int(collectorCarrier));
        require(tx.outputs[3].value == int(collectorCarrier));
        require(tx.outputs[4].value == int(collectorCarrier));
        require(tx.outputs[2].tokenCategory == 0x && tx.outputs[3].tokenCategory == 0x);
        require(tx.outputs[4].tokenCategory == 0x && tx.outputs[5].tokenCategory == 0x);
        require(tx.outputs[5].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.outputs[5].value >= 546);
        require(tx.outputs[5].value >= tx.inputs[1].value - 1000 - 3 * int(collectorCarrier) - 5000);
    }
}
