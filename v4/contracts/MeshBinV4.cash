pragma cashscript ^0.14.0;

import "./lib/bin.cash";

// =============================================================================
// MeshBinV4: one price level of a position. Holds BCH and the pair's token and
// flips in place: buys and sells recreate the same UTXO at the same index.
// Spec: v4/docs/MeshBinV4.md. Decisions: docs-site LPS/v4plan/DECISIONS.md.
// =============================================================================
//
// The bin is input i and output i with identical locking bytecode. Amounts
// are derived from the transaction, never passed in:
//   dt = tokens out − tokens in        ds = sats out − sats in
// Value at the bin's own price may not fall:
//   dt < 0  (trader buys tokens)            ds·askDen + dt·askNum ≥ 0
//   dt ≥ 0  (trader sells, or a top-up)     ds·bidDen + dt·bidNum ≥ 0
// Exact integer maths with no division, so any rounding is the trader's loss.
// The chosen side's num and den must be > 0, and ask ≥ bid, so a misconfigured
// bin can't be drained.
//
// Parameters are fixed-width pushes (no 1-byte values, which minimal-push rules
// would turn into OP_N), so the redeem script's parameter prefix is always 140
// bytes and the manager can rebuild any bin's address from (params ‖ body).
// Categories are in the VM's byte order. Integers are little-endian.
//
// Paths:
//   fill()      anyone; the rules above
//   owner(k)    input k carries an NFT of ownerCat: category (any capability)
//               and a non-empty commitment, so a fungible token of the category
//               can't pass. No output rules (withdraw, reprice, move)
//   manage()    input 0 is the position manager (P2SH32 of managerHash) and the
//               transaction's locktime is at least manageAfter (a block height).
//               An absolute height, not the UTXO's age: fills would reset an age
//               (DECISIONS D10). The manager checks everything else
// =============================================================================

contract MeshBinV4(
    bytes32 tokenCat,
    bytes8 bidNum, bytes8 bidDen,
    bytes8 askNum, bytes8 askDen,
    bytes32 ownerCat,
    bytes32 managerHash,
    bytes4 manageAfter
) {
    function fill() {
        int dt, int ds = binDeltas(tokenCat);
        bytes num = bidNum;
        bytes den = bidDen;
        if (dt < 0) {
            num = askNum;
            den = askDen;
        }
        int n = int(num);
        int d = int(den);
        require(min(n, d) > 0);
        require(ds * d + dt * n >= 0);
        // ask ≥ bid, or a round trip through the bin would drain it.
        require(int(askNum) * int(bidDen) >= int(bidNum) * int(askDen));
    }

    function owner(int k) {
        require(ownerOk(k, ownerCat));
    }

    function manage() {
        require(managerAt0(managerHash));
        require(tx.time >= int(manageAfter));
    }
}
